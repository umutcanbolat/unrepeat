{
  "name": "unrepeat",
  "version": "2.1.1",
  "packageManager": "pnpm@11.21.0",
  "description": "Find the shortest repeating pattern in a string",
  "type": "module",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "tsc",
    "prepack": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umutcanbolat/unrepeat.git"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "repeat",
    "repetition",
    "reverse",
    "unrepeat",
    "no-repeat",
    "string-repetition",
    "inverse",
    "string",
    "utility"
  ],
  "author": "Umut Canbolat",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/umutcanbolat/unrepeat/issues"
  },
  "homepage": "https://github.com/umutcanbolat/unrepeat#readme",
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
